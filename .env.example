# ─────────────────────────────────────────────
# Agricon environment variables
# Copy to .env (local dev) — NEVER commit real .env
# ─────────────────────────────────────────────

# Payload CMS secret — REQUIRED in production (use a long random string)
#   Generate: openssl rand -base64 32
PAYLOAD_SECRET=dev-secret-change-me

# Local development database (SQLite, zero setup)
DATABASE_URI=file:./agricon-dev.db

# Production database (Vercel Postgres / Neon)
# When set, the app automatically switches from SQLite to Postgres
POSTGRES_URL=

# Vercel Blob storage for media uploads (production only)
# Required for the admin panel image uploads to work
BLOB_READ_WRITE_TOKEN=

# Public site URL used for SEO canonical / sitemap / robots
# Must match your real domain. Read by src/app/(frontend)/sitemap.ts and robots.ts
NEXT_PUBLIC_SITE_URL=https://www.agricon.com
