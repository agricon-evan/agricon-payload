# ─────────────────────────────────────────────
# Agricon environment variables
# Copy to .env (local dev) — NEVER commit real .env
# ─────────────────────────────────────────────

# Payload CMS secret — REQUIRED in production (use a long random string)
#   Generate: openssl rand -base64 32
PAYLOAD_SECRET=dev-secret-change-me

# Local development database (SQLite, zero setup)
DATABASE_URI=file:./agricon-dev.db

# Production database (Vercel Postgres / Neon)
# When set, the app automatically switches from SQLite to Postgres
POSTGRES_URL=

# Vercel Blob storage for media uploads (production only)
# Required for the admin panel image uploads to work
BLOB_READ_WRITE_TOKEN=

# Public site URL used for SEO canonical / sitemap / robots
# Must match your real domain. Read by src/app/(frontend)/sitemap.ts and robots.ts
#
# The real domain is the .cn one. Do NOT use www.agricon.com: that host serves an
# unrelated WordPress/WooCommerce site, so pointing canonical/sitemap/robots at it
# would advertise a different website as this app's canonical home.
# Production is reachable at https://agricon-payload.vercel.app but that is not
# canonical (docs/OPERATIONS.md §1).
NEXT_PUBLIC_SITE_URL=https://www.agricon.cn

# ─────────────────────────────────────────────
# Email (SMTP) — optional for dev; required in production
# When SMTP_HOST is unset, emails are logged to the console instead.
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@agricon.com
EMAIL_FROM_NAME=Agricon
# Where new inquiry notifications are sent (defaults to EMAIL_FROM)
INQUIRY_NOTIFY_EMAIL=sales@agricon.com
